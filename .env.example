# Copy this to .env and fill in values from Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Almanac weight tracker (/weight/) — set in Netlify env:
# WEIGHT_AUTH_SECRET=<random>
# WEIGHT_VAPID_PUBLIC / WEIGHT_VAPID_PRIVATE / WEIGHT_VAPID_SUBJECT

# House Quest (/house-quest/) — set in Netlify env:
#   netlify env:set HQ_AUTH_SECRET <random>        # session-token signing key (falls back to WEIGHT_AUTH_SECRET)
#   HQ_VAPID_PUBLIC / HQ_VAPID_PRIVATE / HQ_VAPID_SUBJECT  # web push (falls back to WEIGHT_VAPID_*)
